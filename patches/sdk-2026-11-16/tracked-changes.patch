+// What frame generation's state is, for settings screens. Not a cvar: a cvar set from code
+// is saved with the player's settings (the overlay's Save) and a file or the command line
+// could set it. A mutex, not callbacks: the graphics threads write it, any thread reads it.
+std::mutex frame_generation_status_mutex;
+Presenter::FrameGenerationStatus frame_generation_status;
+}  // namespace
+
+void Presenter::UpdateFrameGenerationStatus() {
+  FrameGenerationStatus status;
+  if (!frame_generation_supported_) {
+    status.state = FrameGenerationState::kUnavailable;
+    status.why = FrameGenerationUnsupportedReason();
+  } else if (frame_generation_unavailable_.load(std::memory_order_acquire)) {
+    status.state = FrameGenerationState::kUnavailable;
+    status.why = "FAILED";
+  } else {
+    status.state = FrameGenerationState::kAvailable;
+  }
+  std::lock_guard lock(frame_generation_status_mutex);
+  frame_generation_status = std::move(status);
+}
+
+Presenter::FrameGenerationStatus Presenter::GetFrameGenerationStatus() {
+  std::lock_guard lock(frame_generation_status_mutex);
+  return frame_generation_status;
+}
+
+void Presenter::SetFrameGenerationUnavailable(const char* reason) {
+  if (frame_generation_unavailable_.exchange(true, std::memory_order_acq_rel)) {
+    return;
+  }
+  REXLOG_WARN(
+      "Presenter: frame generation can't run ({}); presenting as without it from the next "
+      "connection",
+      reason);
+  SetFrameGenerationUiSeparation(false);
+  UpdateFrameGenerationStatus();
+}
