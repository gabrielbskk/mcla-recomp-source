+namespace {
+// A guest query's record holds two sample count structs: the end snapshot at +0x00 and the begin
+// snapshot 0x20 after it (the game's Direct3D 9 sets RB_SAMPLE_COUNT_ADDR to the record plus
+// is_begin << 5).
+constexpr uint32_t kOcclusionBeginOffset = sizeof(xenos::xe_gpu_depth_sample_counts);
+// Counts still on their way: a longer queue means the host GPU is far behind (or lost), the
+// oldest are given up.
+constexpr size_t kOcclusionMaxPending = 64;
+// The draws of the first queries and of every 240th are described in the log (occlusion_query_log).
+constexpr uint64_t kOcclusionDrawLogFirstQueries = 16;
+constexpr uint64_t kOcclusionDrawLogEvery = 240;
+// Draws of a query that no host draw was recorded for, described in the log without a limit on
+// the query's ordinal (the first few only).
+constexpr uint64_t kOcclusionLeftOutLogMax = 24;
