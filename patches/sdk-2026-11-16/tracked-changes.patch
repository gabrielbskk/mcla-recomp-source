+int CommandProcessor::MatchUnscaledResolveCopyRule(uint32_t written_address,
+                                                   uint32_t written_length) {
+  const std::string& rules_text = REXCVAR_GET(resolve_unscaled_copy_rules);
+  if (rules_text.empty() || rules_text == "off") {
+    return -1;
