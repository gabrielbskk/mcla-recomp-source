+VkPipeline VulkanRenderTargetCache::GetDirectResolveStretchPipeline(
+    draw_util::ResolveCopyShaderIndex copy_shader) {
+  size_t index = size_t(GetDirectResolveCopyShader(copy_shader));
+  if (index >= size_t(draw_util::ResolveCopyShaderIndex::kCount)) {
+    return VK_NULL_HANDLE;
+  }
+  const ResolveDirectShaderCode& shader_code = kResolveDirectStretchShaders[index];
+  bool scaled = IsDrawResolutionScaled();
+  const uint32_t* code = scaled ? shader_code.scaled : shader_code.unscaled;
+  size_t code_size = scaled ? shader_code.scaled_size_bytes : shader_code.unscaled_size_bytes;
+  if (!code) {
+    return VK_NULL_HANDLE;
+  }
+  if (direct_resolve_stretch_pipelines_[index] == VK_NULL_HANDLE &&
+      !direct_resolve_stretch_failed_ && direct_resolve_pipeline_layout_ != VK_NULL_HANDLE) {
+    const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+    VkPipeline pipeline = ui::vulkan::util::CreateComputePipeline(
+        vulkan_device, direct_resolve_pipeline_layout_, code, code_size);
+    if (pipeline != VK_NULL_HANDLE) {
+      vulkan_device->SetObjectName(
+          VK_OBJECT_TYPE_PIPELINE, pipeline,
+          fmt::format("Direct stretching {} from 1x RT",
+                      draw_util::resolve_copy_shader_info[index].debug_name)
+              .c_str());
+      direct_resolve_stretch_pipelines_[index] = pipeline;
+    } else {
+      direct_resolve_stretch_failed_ = true;
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the stretching direct {} pipeline",
+                   draw_util::resolve_copy_shader_info[index].debug_name);
+    }
+  }
+  return direct_resolve_stretch_pipelines_[index];
+}
