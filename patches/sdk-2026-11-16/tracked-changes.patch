+  // One barrier for the scaled data the resolves wrote, and one for the shared
+  // memory (the span of all the destinations, as written), for all the copies.
+  uint32_t written_first = UINT32_MAX;
+  uint32_t written_end = 0;
+  for (const PendingUnscaledResolveCopy& copy : copies) {
+    written_first = std::min(written_first, copy.written_address);
+    written_end = std::max(written_end, copy.written_address + copy.written_length);
+  }
+  texture_cache_->UseScaledResolveBufferForRead();
+  shared_memory_->Use(VulkanSharedMemory::Usage::kComputeWrite,
+                      std::pair<uint32_t, uint32_t>(written_first, written_end - written_first));
+  SubmitBarriers(true);
+
+  BindExternalComputePipeline(resolve_downscale_pipeline_);
+  const uint32_t scale_x = texture_cache_->draw_resolution_scale_x();
+  const uint32_t scale_y = texture_cache_->draw_resolution_scale_y();
+  for (const PendingUnscaledResolveCopy& copy : copies) {
+    VkDescriptorSet descriptor_set = AllocateSingleTransientDescriptor(
