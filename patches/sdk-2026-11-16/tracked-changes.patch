+ID3D12PipelineState* D3D12CommandProcessor::GetMsaaLineGuardPipeline(void* handle) const {
+  if (!REXCVAR_GET(d3d12_msaa_line_guard)) {
+    return nullptr;
+  }
+  uint32_t samples = pipeline_cache_->GetMsaaLineGuardSamples(handle);
+  if (!samples) {
+    return nullptr;
