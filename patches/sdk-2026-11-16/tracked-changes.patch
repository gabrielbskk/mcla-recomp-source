+  if (outdated || paint_mode_ != PaintMode::kGuestOutputThreadImmediately) {
+    // Take the painting over (waiting for a paint in progress) only for this;
+    // a guest frame refreshed meanwhile is requested from the UI thread, which
+    // doesn't paint it: taking it over for every overlay would drop frames.
+    if (paint_mode_ == PaintMode::kGuestOutputThreadImmediately) {
+      SetPaintModeFromUIThread(PaintMode::kUIThreadOnRequest);
+    }
+    if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated) {
+      UpdateSurfacePaintConnectionFromUIThread(nullptr, false);
+      if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated) {
+        // Retry in the next frame, giving the window system time.
+        request_repaint_immediately = true;
+      }
+    }
+    if (resuming &&
+        surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedPaintable) {
+      // Back from the suspension, where the UI thread painted the UI into the
+      // image itself. Before the guest output thread paints again, the overlay
+      // is drawn (none of its frames goes without the UI, or with the overlay
+      // from before the suspension), and the latest guest frame, if it hasn't
+      // been shown, is shown with it from here, as the guest output thread
+      // would paint it.
+      SetPaintModeFromUIThread(PaintMode::kUIThreadOnRequest);
+      if (draw_ui) {
+        draw_overlay = false;
+        if (!RenderUIOverlayForPaintsFromUIThread()) {
+          request_repaint_immediately = true;
+        }
+      } else {
+        ui_overlay_active_.store(false, std::memory_order_release);
+      }
+      if (paint_requested && IsUIOverlayPaintModeActive()) {
+        tls_in_ui_overlay_resume_paint = true;
+        paint_result = PaintAndPresent(false);
+        tls_in_ui_overlay_resume_paint = false;
+        if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated) {
+          request_repaint_immediately = true;
+        }
+      }
+    }
+    SetPaintModeFromUIThread(GetDesiredPaintModeFromUIThread(
+        surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedPaintable));
+  }
+  if (draw_overlay && paint_mode_ != PaintMode::kNone) {
+    // As fast as the UI thread would paint (the overlay isn't presented here).
+    WaitForUITickFromUIThread();
+    if (!RenderUIOverlayForPaintsFromUIThread()) {
+      request_repaint_immediately = true;
+    }
+  } else if (!draw_ui) {
+    ui_overlay_active_.store(false, std::memory_order_release);
+  }
+  is_in_ui_thread_paint_ = false;
+  if (paint_result == PaintResult::kGpuLostExternally ||
+      paint_result == PaintResult::kGpuLostResponsible) {
+    if (host_gpu_loss_callback_) {
+      host_gpu_loss_callback_(paint_result == PaintResult::kGpuLostResponsible, true);
+    }
+    // The loss callback might have destroyed the presenter.
+    return;
+  }
+  bool request_repaint_at_tick = false;
+  if (paint_mode_ != PaintMode::kNone) {
+    if (request_ui_paint_after_current_ui_thread_paint_ && !ui_drawers_.empty()) {
+      request_repaint_at_tick = true;
+    }
+  } else {
+    request_repaint_immediately = false;
+  }
+  if (request_repaint_at_tick || request_repaint_immediately) {
+    RequestPaintOrConnectionRecoveryViaWindow(request_repaint_immediately);
+  }
+}
+
+bool Presenter::RenderUIOverlayForPaintsFromUIThread() {
+  const uint64_t ui_frame = ++ui_frames_drawn_;
+  const bool rendered = RenderUIOverlayFromUIThread();
+  if (!rendered) {
+    // The UI thread paints as before (presenting the UI) until the next
+    // connection.
+    ui_overlay_render_failed_ = true;
+    REXLOG_WARN("Presenter: the UI overlay couldn't be drawn; the UI thread paints the UI");
+  } else {
+    ui_overlay_ui_frame_.store(ui_frame, std::memory_order_relaxed);
+  }
+  // A dialog that closed itself while drawn left its last frame in the layer:
+  // with no drawers left, nothing is put over the image anymore.
+  ui_overlay_active_.store(rendered && !ui_drawers_.empty(), std::memory_order_release);
+  return rendered;
+}
+
+bool Presenter::IsUIOverlayPaintModeActive() const {
+  if (!ui_overlay_paint_mode_ || ui_overlay_paint_suspended_ || ui_overlay_render_failed_) {
+    return false;
+  }
+  // With implicit vsync the guest output thread's presents would wait for it,
+  // and without host_present_from_non_ui_thread it doesn't present at all:
+  // there the UI thread paints as before.
+  return ui_overlay_paint_forced_ ||
+         (ui_overlay_paint_user_ && REXCVAR_GET(host_present_from_non_ui_thread) &&
+          !surface_paint_connection_has_implicit_vsync_);
+}
+
+void Presenter::UpdateUIOverlayPaintSuspensionFromUIThread(bool draw_ui) {
+  // No guest frame for this long with UI to show (the time before the first
+  // guest frame, a long load, a hang): the UI thread paints the UI itself, at
+  // the display's rate. Frame generation, whose pacer then stops presenting,
+  // keeps 1 s.
+  constexpr uint64_t kSilentNs = 250'000'000;
+  constexpr uint64_t kSilentForcedNs = 1'000'000'000;
+  // Resumed once guest frames have been coming for this long with no gap over
+  // kGuestOutputSteadyGapNs, so that a loading hitch doesn't switch back and
+  // forth.
+  constexpr uint64_t kSteadyNs = 250'000'000;
+  const uint64_t now = PresentLog::Now();
+  const uint64_t last = last_refresh_ns_.load(std::memory_order_acquire);
+  const uint64_t steady_since = guest_output_steady_since_ns_.load(std::memory_order_relaxed);
+  if (!ui_overlay_paint_suspended_) {
+    // Before the first guest frame, silent since the presenter was set up.
+    const uint64_t since = last ? last : ui_overlay_paint_start_ns_;
+    const uint64_t silent_ns = ui_overlay_paint_forced_ ? kSilentForcedNs : kSilentNs;
+    if (draw_ui && now > since + silent_ns) {
+      ui_overlay_paint_suspended_ = true;
+      ui_overlay_paint_suspended_ns_ = now;
+      ui_overlay_active_.store(false, std::memory_order_release);
+      REXLOG_INFO("Presenter: no guest frame for {} ms with UI to show; UI overlay painting "
+                  "suspended",
+                  (now - since) / 1'000'000);
+      if (PresentLog::Get().enabled()) {
+        PresentLog::Get().Suspension(now, 1);
+      }
+    }
+  } else if (!draw_ui || (last && now < last + kGuestOutputSteadyGapNs && steady_since &&
+                          now >= steady_since + kSteadyNs)) {
+    ui_overlay_paint_suspended_ = false;
+    REXLOG_INFO("Presenter: UI overlay painting resumed after {} ms{}",
+                (now - ui_overlay_paint_suspended_ns_) / 1'000'000,
+                draw_ui ? "" : " (no UI to show)");
+    if (PresentLog::Get().enabled()) {
+      PresentLog::Get().Suspension(now, draw_ui ? 0 : 2);
+    }
+  }
+}
