+  std::string driver_name;
+  std::getline(selection, driver_name);
+  // Never use arbitrary paths from app data as a library name.
+  if (driver_name != "libvulkan_freedreno.so" &&
+      driver_name != "libvulkan_panfrost.so") {
+    REXLOG_WARN("Unknown selected Android Vulkan driver; using system Vulkan");
+    return nullptr;
+  }
+  const std::filesystem::path driver = driver_dir / driver_name;
+  if (!std::filesystem::is_regular_file(driver)) {
+    REXLOG_WARN("Selected Android Vulkan driver is missing; using system Vulkan");
+    return nullptr;
+  }
+  Dl_info self_info{};
+  if (!dladdr(reinterpret_cast<void*>(&OpenSelectedAndroidDriver), &self_info) ||
+      !self_info.dli_fname) {
+    REXLOG_WARN("Cannot locate Android Vulkan hook libraries; using system Vulkan");
+    return nullptr;
+  }
+  const std::filesystem::path hook_dir = std::filesystem::path(self_info.dli_fname).parent_path();
