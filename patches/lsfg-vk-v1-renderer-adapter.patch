+void Context::record(Vulkan& vk, const Core::CommandBuffer& buffer) {
+    if (buffer.getState() != Core::CommandBufferState::Recording || vk.generationCount != 1)
+        throw std::invalid_argument("Record-only path requires recording buffer and 2x mode");
+    this->mipmaps.Dispatch(buffer, this->frameIdx);
+    for (size_t i = 0; i < 7; ++i)
+        this->alpha.at(6 - i).Dispatch(buffer, this->frameIdx);
+    this->beta.Dispatch(buffer, this->frameIdx);
+    for (size_t i = 0; i < 7; ++i) {
+        this->gamma.at(i).Dispatch(buffer, this->frameIdx, 0);
+        if (i >= 4) this->delta.at(i - 4).Dispatch(buffer, this->frameIdx, 0);
+    }
+    this->generate.Dispatch(buffer, this->frameIdx, 0);
+    ++this->frameIdx;
+}
