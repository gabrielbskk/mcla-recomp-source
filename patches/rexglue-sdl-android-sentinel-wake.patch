+        if (added_wakeup_event)
+#endif
         SDL_SendWakeupEvent();
     }
 
@@ -1751,14 +1766,17 @@
             return true;
         }
 
-        Uint64 delay = -1;
+        // Retain the standard SDL device polling cadence (HID/sensors may
+        // need polling even without a Java event). Real events still wake
+        // the semaphore immediately; a sentinel never needs to wake it.
+        Uint64 delay = EVENT_POLL_INTERVAL_NS;
